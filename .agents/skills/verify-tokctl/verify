#!/usr/bin/env python3
"""Drive the real tokctl binary against offline fixtures in a temp HOME."""

import atexit
import contextlib
import datetime as dt
import fcntl
import fnmatch
import hashlib
import json
import os
import pty
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import time
import tomllib
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[3]
BIN = ROOT / "target" / "debug" / "tokctl"
SCRATCH = Path(tempfile.mkdtemp(prefix="verify-tokctl-"))
CHILD_GROUPS: list[int] = []
SECRET_NAME = re.compile("KEY|TOKEN|SECRET|PASSWORD")
TRIPWIRE_DIR = SCRATCH / "tripwire"
TRIPWIRE_LOG = SCRATCH / "tripwire.log"
# Network and install commands. A stub first on PATH logs the call and exits 97, so a drive that runs one fails.
TRIPWIRE_TOOLS = (
    *("curl", "wget", "nc", "ncat", "ssh", "scp", "sftp", "rsync", "telnet", "ftp"),
    *("pip", "pip3", "uv", "uvx", "npm", "npx", "pnpm", "yarn", "brew", "apt", "apt-get", "gem"),
    *("cargo", "rustup", "go", "docker", "gh"),
)
CLOSED_PROXY = "http://127.0.0.1:9"
CARGO = shutil.which("cargo") or str(Path.home() / ".cargo/bin/cargo")
SHARED_PATHS = [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "build.rs",
    ".agents/skills/verify-tokctl/*",
]


class DriveFailure(Exception):
    pass


@dataclass(frozen=True)
class Drive:
    proves: str
    paths: list[str]
    run: Callable[[Run], str]
    timeout: float


def git(*args: str) -> str:
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    return subprocess.run(
        ["git", *args], cwd=ROOT, env=env, capture_output=True, text=True, check=True
    ).stdout.strip()


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else "absent"


def checkout_state() -> dict[str, str]:
    """HEAD, branch, git config and hooks, and every changed, untracked, or ignored path.

    Changed and untracked files compare by content; ignored files by size and mtime, because
    target/ holds too many files to hash. Only `.verify/` may change during the drives.
    """
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    status = ["git", "status", "--porcelain=v2", "--branch", "-z", "-uall", "--ignored"]
    listing = subprocess.run(status, cwd=ROOT, env=env, capture_output=True, check=True).stdout
    git_dir = (ROOT / git("rev-parse", "--git-common-dir")).resolve()
    state = {".git/config": digest(git_dir / "config")}
    state |= {f".git/hooks/{hook.name}": digest(hook) for hook in (git_dir / "hooks").glob("*")}
    entries = iter(os.fsdecode(listing).split("\0"))
    for entry in entries:
        if entry.startswith("# branch.oid ") or entry.startswith("# branch.head "):
            key, _, value = entry[2:].partition(" ")
            state[key] = value
            continue
        if not entry or entry.startswith("#"):
            continue
        kind = entry[0]
        fields = {"1": 8, "2": 9, "u": 10}.get(kind)
        path = entry[2:] if fields is None else entry.split(" ", fields)[fields]
        if kind == "2":
            next(entries)
        if path.startswith(".verify/"):
            continue
        target = ROOT / path
        if kind == "!":
            if target.exists():
                info = target.stat()
                state[path] = f"ignored:{info.st_size}:{info.st_mtime_ns}"
        else:
            status_code = entry.split(" ", 2)[1] if fields else kind
            state[path] = f"{status_code}:{digest(target)}"
    return state


def unique_run_dir(stem: str) -> Path:
    runs = ROOT / ".verify" / "runs"
    runs.mkdir(parents=True, exist_ok=True)
    for attempt in range(1, 1000):
        candidate = runs / (stem if attempt == 1 else f"{stem}-{attempt}")
        try:
            candidate.mkdir()
        except FileExistsError:
            continue
        return candidate
    raise OSError(f"no free run directory for {stem} under {runs}")


class Run:
    def __init__(self, run_dir: Path, name: str) -> None:
        self.run_dir = run_dir
        self.name = name
        self.home = Path(tempfile.mkdtemp(prefix=f"{name}-", dir=SCRATCH))
        self.env = {
            "PATH": f"{TRIPWIRE_DIR}:/usr/bin:/bin",
            "TRIPWIRE_LOG": str(TRIPWIRE_LOG),
            **{
                variable: CLOSED_PROXY
                for base in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY")
                for variable in (base, base.lower())
            },
            "HOME": str(self.home),
            "TZ": "UTC",
            "TERM": "xterm-256color",
            "XDG_CONFIG_HOME": str(self.home / "config"),
            "XDG_DATA_HOME": str(self.home / "data"),
            "TOKCTL_CACHE_DIR": str(self.home / "cache"),
            "TOKCTL_CLAUDE_DIR": str(self.home / "claude"),
            "TOKCTL_CODEX_DIR": str(self.home / "codex"),
            "TOKCTL_CURSOR_DIR": str(self.home / "cursor"),
        }
        for key in ("claude/project", "codex", "cursor", "repo"):
            (self.home / key).mkdir(parents=True)
        self.step = 0

    def log(self, argv: list[str], code: int, out: str, err: str) -> None:
        self.step += 1
        record = {
            "argv": argv,
            "env": {k: "<redacted>" if SECRET_NAME.search(k) else v for k, v in self.env.items()},
            "exit": code,
            "stdout": out,
            "stderr": err,
        }
        (self.run_dir / f"{self.name}.{self.step}.json").write_text(json.dumps(record, indent=2))

    def tokctl(self, *args: str, expect_exit: int = 0) -> str:
        argv = [str(BIN), *args]
        proc = subprocess.run(
            argv, env=self.env, capture_output=True, text=True, timeout=20, start_new_session=True
        )
        self.log(argv, proc.returncode, proc.stdout, proc.stderr)
        if proc.returncode != expect_exit:
            raise DriveFailure(
                f"`tokctl {' '.join(args)}` expected exit {expect_exit}, got {proc.returncode}: {proc.stderr.strip()[:200]}"
            )
        return proc.stdout


def check(actual: object, expected: object, what: str) -> None:
    if actual != expected:
        raise DriveFailure(f"{what}: expected {expected!r}, got {actual!r}")


def claude_line(message_id: str, inp: int, out: int, read: int, write: int) -> str:
    usage = {
        "input_tokens": inp,
        "output_tokens": out,
        "cache_read_input_tokens": read,
        "cache_creation_input_tokens": write,
    }
    return json.dumps(
        {
            "type": "assistant",
            "timestamp": "2026-04-22T12:00:00Z",
            "sessionId": "s-claude",
            "message": {"id": message_id, "model": "claude-sonnet-4-6", "usage": usage},
        }
    )


def codex_session(cwd: Path) -> str:
    usage = {
        "input_tokens": 200,
        "cached_input_tokens": 50,
        "output_tokens": 60,
        "total_tokens": 260,
    }
    lines = [
        {
            "timestamp": "2026-04-20T12:49:04Z",
            "type": "session_meta",
            "payload": {"id": "s-codex", "cwd": str(cwd), "originator": "Codex Desktop"},
        },
        {
            "timestamp": "2026-04-20T12:49:05Z",
            "type": "turn_context",
            "payload": {"model": "gpt-5.4"},
        },
        {
            "timestamp": "2026-04-20T12:49:10Z",
            "type": "event_msg",
            "payload": {"type": "token_count", "info": {"last_token_usage": usage}},
        },
    ]
    return "".join(json.dumps(line) + "\n" for line in lines)


def by_date(rows: list[dict[str, Any]]) -> dict[str, int]:
    return {row["date"]: row["totalTokens"] for row in rows}


EXPECTED_REPORT = {"2026-04-20": 260, "2026-04-22": 840}
# The control passes only when the drive fails on exactly this planted expectation.
CONTROL_EXPECTED = {**EXPECTED_REPORT, "2026-04-22": 841}
CONTROL_FAILURE = f"daily totals from fixtures: expected {CONTROL_EXPECTED!r}, got "


def drive_report(run: Run, expected: dict[str, int] | None = None) -> str:
    session = run.home / "claude/project/session.jsonl"
    session.write_text(claude_line("m1", 100, 40, 500, 200) + "\n")
    (run.home / "codex/rollout.jsonl").write_text(codex_session(run.home / "repo"))
    check(
        by_date(json.loads(run.tokctl("daily", "--json"))),
        expected or EXPECTED_REPORT,
        "daily totals from fixtures",
    )
    session.write_text(session.read_text() + claude_line("m2", 10, 5, 0, 0) + "\n")
    check(
        by_date(json.loads(run.tokctl("daily", "--json")))["2026-04-22"],
        855,
        "Claude total after the session file grew",
    )
    sessions = {
        row["session_id"]: row["source"] for row in json.loads(run.tokctl("session", "--json"))
    }
    check(sessions, {"s-claude": "claude", "s-codex": "codex"}, "session sources")
    return "daily and session JSON match fixtures; a grown session file replaces, not double-counts"


def drive_doctor(run: Run) -> str:
    report = json.loads(run.tokctl("doctor", "--json"))
    check((run.home / "cache").exists(), False, "doctor created a cache directory")
    check(report["check_counts"]["error"], 0, "doctor errors on an empty HOME")
    (run.home / "claude/project/session.jsonl").write_text(claude_line("m1", 1, 1, 0, 0) + "\n")
    run.tokctl("daily", "--json")
    checks = json.loads(run.tokctl("doctor", "--json"))["checks"]
    cache = [(c["severity"], c["message"]) for c in checks if c["category"] == "cache"]
    if not cache or any(severity != "ok" for severity, _ in cache):
        raise DriveFailure(f"doctor cache checks after ingest are not all ok: {cache}")
    return "doctor stays read-only on an empty HOME and reports the cache healthy after ingest"


def screen_text(raw: bytes) -> str:
    return re.sub(
        r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[()][0-9A-Za-z]|\x1b[=>]",
        "",
        raw.decode("utf-8", "replace"),
    )


def drive_ui(run: Run) -> str:
    argv = [str(BIN), "ui", "--demo", "--cache-dir", str(run.home / "demo")]
    pid, fd = pty.fork()
    if pid == 0:
        os.execve(argv[0], argv, run.env)
    CHILD_GROUPS.append(pid)
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 36, 120, 0, 0))
    os.kill(pid, signal.SIGWINCH)
    raw = bytearray()

    def wait_for(text: str, seconds: float = 8) -> None:
        deadline = time.monotonic() + seconds
        while text not in screen_text(bytes(raw)):
            if time.monotonic() > deadline:
                raise DriveFailure(f"UI never rendered {text!r}")
            if select.select([fd], [], [], 0.1)[0]:
                try:
                    raw.extend(os.read(fd, 65536))
                except OSError:
                    raise DriveFailure(f"UI exited before rendering {text!r}") from None

    try:
        wait_for("MONTHS")
        os.write(fd, b"at")
        wait_for("PROVIDER")
        os.write(fd, b"q")
        deadline = time.monotonic() + 5
        while (done := os.waitpid(pid, os.WNOHANG))[0] == 0:
            if time.monotonic() > deadline:
                raise DriveFailure("UI did not exit within 5s of `q`")
            if select.select([fd], [], [], 0.1)[0]:
                with contextlib.suppress(OSError):
                    raw.extend(os.read(fd, 65536))
        CHILD_GROUPS.remove(pid)
        check(os.waitstatus_to_exitcode(done[1]), 0, "UI exit code after `q`")
    finally:
        (run.run_dir / "ui.screen.txt").write_text(screen_text(bytes(raw)))
        os.close(fd)
    return "demo UI renders MONTHS, switches to PROVIDER on `at`, and quits cleanly on `q`"


DRIVES = {
    "report": Drive(
        "Claude and Codex fixtures produce exact daily and session JSON; a grown file replaces its snapshot",
        ["src/**"],
        drive_report,
        30,
    ),
    "doctor": Drive(
        "doctor is read-only on an empty HOME and reports a healthy cache after ingest",
        ["src/store/**", "src/cli/**", "src/doctor*", "src/main.rs"],
        drive_doctor,
        20,
    ),
    "ui": Drive(
        "tokctl ui --demo renders in a PTY, responds to keys, and exits 0 on q",
        ["src/tui/**", "src/demo.rs", "src/main.rs", "src/cli/**"],
        drive_ui,
        20,
    ),
}
SMOKE = "report"


def cleanup() -> None:
    for group in CHILD_GROUPS:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(group, signal.SIGKILL)
    shutil.rmtree(SCRATCH, ignore_errors=True)


def changed_files() -> set[str]:
    branches = git("branch", "--list", "--all", "main", "origin/main").split()
    base = git("merge-base", "HEAD", "main" if "main" in branches else "origin/main")
    files = set(git("diff", "--name-only", base).splitlines())
    return files | set(git("ls-files", "--others", "--exclude-standard").splitlines())


def select_changed() -> list[str]:
    files = changed_files()
    if any(fnmatch.fnmatch(f, p) for f in files for p in SHARED_PATHS):
        return list(DRIVES)
    picked = [
        n for n, d in DRIVES.items() if any(fnmatch.fnmatch(f, p) for f in files for p in d.paths)
    ]
    return picked or [SMOKE]


def plant_tripwires() -> None:
    TRIPWIRE_DIR.mkdir(exist_ok=True)
    for tool in TRIPWIRE_TOOLS:
        stub = TRIPWIRE_DIR / tool
        stub.write_text(f'#!/bin/sh\necho "{tool} $*" >> "$TRIPWIRE_LOG"\nexit 97\n')
        stub.chmod(0o755)


def tripwire_hits() -> str:
    return TRIPWIRE_LOG.read_text().strip() if TRIPWIRE_LOG.exists() else ""


def preflight(run_dir: Path) -> None:
    plant_tripwires()
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    build = subprocess.run(
        [CARGO, "build", "--locked", "--bin", "tokctl"],
        cwd=ROOT,
        env=env,
        capture_output=True,
        text=True,
    )
    (run_dir / "build.log").write_text(build.stderr)
    if build.returncode != 0:
        sys.exit(f"preflight: cargo build failed, see {run_dir / 'build.log'}")
    version = tomllib.loads((ROOT / "Cargo.toml").read_text())["package"]["version"]
    reported = subprocess.run(
        [str(BIN), "--version"], capture_output=True, text=True
    ).stdout.strip()
    if reported != f"tokctl {version}":
        sys.exit(f"preflight: {BIN} reports {reported!r}, checkout is {version}")
    probe = Run(run_dir, "preflight")
    real_home = Path.home().resolve()
    for key, value in probe.env.items():
        if (
            key != "PATH"
            and value.startswith("/")
            and Path(value).resolve().is_relative_to(real_home)
        ):
            sys.exit(f"preflight: {key}={value} is inside the real HOME")
    if (probe.home / ".config/tokctl/cursor-credentials.json").exists():
        sys.exit("preflight: temp HOME has Cursor credentials; Cursor sync would reach the network")


def control() -> int:
    """Re-drive the smoke drive against a wrong daily total; pass only when FAIL is observed."""
    return execute([SMOKE], control=True)


def execute(names: list[str], control: bool = False) -> int:
    sha = git("rev-parse", "--short=7", "HEAD")
    dirty = bool(git("status", "--porcelain"))
    stamp = dt.datetime.now(dt.UTC).strftime("%Y%m%dT%H%M%S%fZ")
    run_dir = unique_run_dir(f"{stamp}-{sha}{'-dirty' if dirty else ''}")
    results: list[dict[str, object]] = []
    changed: list[str] = []
    # The build in preflight may write target/; the snapshot starts after it.
    before: dict[str, str] | None = None
    try:
        preflight(run_dir)
        before = checkout_state()
        for name in names:
            drive = DRIVES[name]
            started = time.monotonic()
            try:
                if control:
                    detail = drive_report(Run(run_dir, "control"), CONTROL_EXPECTED)
                else:
                    detail = drive.run(Run(run_dir, name))
                result = "PASS"
            except (DriveFailure, subprocess.TimeoutExpired) as error:
                result, detail = "FAIL", str(error)
            except Exception as error:
                result, detail = "FAIL", f"drive crashed: {type(error).__name__}: {error}"
            seconds = round(time.monotonic() - started, 1)
            if hits := tripwire_hits():
                result, detail = "FAIL", f"tripwire fired: {hits}"
                TRIPWIRE_LOG.unlink()
            if seconds > drive.timeout and result == "PASS":
                result, detail = "FAIL", f"took {seconds}s, budget {drive.timeout}s"
            print(f"{result} {'control' if control else name} {seconds}s {detail}")
            results.append({"drive": name, "result": result, "seconds": seconds, "detail": detail})
    finally:
        if before is not None:
            after = checkout_state()
            changed = sorted(
                p for p in before.keys() | after.keys() if before.get(p) != after.get(p)
            )
        if changed:
            print(f"FAIL checkout changed during the run: {', '.join(changed)}")
        failed = bool(changed) or not results or any(r["result"] == "FAIL" for r in results)
        summary = {
            "sha": git("rev-parse", "HEAD"),
            "dirty": dirty,
            "control": control,
            "result": "FAIL" if failed else "PASS",
            "checkout_changed": changed,
            "drives": results,
        }
        (run_dir / "summary.json").write_text(json.dumps(summary, indent=2))
        print(f"evidence: {run_dir}")
    if control:
        failures = [str(r["detail"]) for r in results if r["result"] == "FAIL"]
        if not changed and len(failures) == 1 and failures[0].startswith(CONTROL_FAILURE):
            print("control: FAIL observed")
            return 0
        if failures:
            print(f"control: failed for another reason; expected {CONTROL_FAILURE!r}")
        else:
            print("control: passed unexpectedly; the drive cannot fail")
        return 1
    return 1 if failed else 0


def main(argv: list[str]) -> int:
    atexit.register(cleanup)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    if argv == ["list"]:
        for name, drive in DRIVES.items():
            print(f"{name}\t{drive.proves}\t{', '.join(drive.paths)}")
        return 0
    if argv == ["control"]:
        return control()
    if argv == ["all"]:
        return execute(list(DRIVES))
    unknown = [a for a in argv if a not in DRIVES]
    if unknown:
        print(f"unknown drive(s): {', '.join(unknown)}; run `verify list`", file=sys.stderr)
        return 2
    return execute(argv or select_changed())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
